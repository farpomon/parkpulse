# Copy to .env and fill in. .env is gitignored — keep it that way.
# These are your real consular credentials; they never leave this machine.

# --- Account (required) ---
PRENOTAMI_EMAIL=you@example.com
PRENOTAMI_PASSWORD=your-prenotami-password

# --- What to watch ---
# Your account is already tied to a consulate (Vancouver), so there is no
# consulate setting — the Services page shows what Vancouver offers.
# This regex picks the row out of that list. Run `npm run probe` to see the
# exact wording your account gets, then narrow this if it matches more than one.
PRENOTAMI_SERVICE_PATTERN=carta\s*d[i’'`´]?\s*identit
PRENOTAMI_SERVICE_LABEL=carta d'identità

# --- Alerts: configure at least one, or you will only see console output ---

# Telegram — most reliable for something you need to act on within minutes.
# Talk to @BotFather to make a bot, then @userinfobot for your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy.sh — no account needed; install the ntfy app and subscribe to the topic.
# Pick something unguessable: anyone who knows the topic can read your alerts.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Any POST endpoint (Slack, Discord, Zapier, your own service).
WEBHOOK_URL=

# Desktop notification on the machine running the monitor.
# Linux needs notify-send; macOS uses osascript.
PRENOTAMI_DESKTOP_NOTIFY=false

# --- Auto-booking ---
# OFF unless this is exactly true. When on, the two dates below are REQUIRED --
# the config refuses to load without them, because a booker with no window takes
# whatever the consulate offers first, including a date you cannot make.
PRENOTAMI_AUTOBOOK=false
PRENOTAMI_BOOK_EARLIEST=2026-09-01
PRENOTAMI_BOOK_LATEST=2026-12-31

# Optional. Empty means any day of the week.
PRENOTAMI_BOOK_WEEKDAYS=

# Stop just before submitting and screenshot what would have been booked.
# Run at least one cycle like this before arming — see README, "Before you arm it".
PRENOTAMI_BOOK_DRY_RUN=false

# --- Schedule ---
# Empty = poll continuously (the default). Set both to watch only on specific
# days at a specific local time — useful when you know when your consulate
# releases slots, and pointless otherwise, since nothing is watched in between.
#
# A scheduled run is a window, not a single request: the monitor wakes at the
# time below and polls at the usual interval for WINDOW_MINUTES, because slots
# released at 15:00 are gone by 15:10.
PRENOTAMI_SCHEDULE_DAYS=mon,tue
PRENOTAMI_SCHEDULE_TIME=15:00
PRENOTAMI_SCHEDULE_WINDOW_MINUTES=30

# --- Pacing ---
# Seconds between checks. The floor is 60 and the tool refuses anything lower:
# polling a consular site harder than this gets accounts flagged, and a flagged
# account cannot book the appointment you are waiting for.
PRENOTAMI_INTERVAL_SECONDS=300
PRENOTAMI_JITTER_SECONDS=90
PRENOTAMI_MAX_CHECKS_PER_HOUR=20

# Skip checks during these local hours (0-23, -1 to disable). 22 -> 7 wraps
# past midnight. Ignored when a schedule is set — the schedule already decides.
PRENOTAMI_QUIET_START=-1
PRENOTAMI_QUIET_END=-1

# Hours between "still watching, nothing yet" messages. Running unattended,
# this is how you tell "no slots" apart from "the monitor died last Tuesday".
# 0 disables them.
PRENOTAMI_HEARTBEAT_HOURS=24

# --- Browser ---
# Set false to watch it work, or to clear a CAPTCHA by hand.
PRENOTAMI_HEADLESS=true
PRENOTAMI_SCREENSHOTS=true
PRENOTAMI_TIMEOUT_MS=45000

# --- Advanced: only if `probe` shows different wording ---
# Pipe-separated phrases, matched case-insensitively.
# PRENOTAMI_UNAVAILABLE_PHRASES=non ci sono date disponibili|no dates available
# PRENOTAMI_BLOCKED_PHRASES=you already have a booking
